{
  "name": "MrD",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "predev": "pnpm build:client",
    "dev": "concurrently -k \"tsx watch src/index.ts\" \"tsc -w -p client/tsconfig.build.json\"",
    "build": "tsc -p tsconfig.build.json && pnpm build:client",
    "build:client": "tsc -p client/tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Karabo Seipelo",
  "license": "ISC",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "jsdom": "^26.1.0",
    "vitest": "^5.0.4",
    "turbo": "2.11.10"
  },
  "type": "module"
}
