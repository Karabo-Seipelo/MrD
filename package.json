{
  "name": "MrD",
  "version": "1.0.0",
  "private": true,
  "description": "Product search monorepo",
  "scripts": {
    "predev": "pnpm --filter @mrd/web build",
    "dev": "concurrently -k \"pnpm --filter @mrd/api dev\" \"pnpm --filter @mrd/web dev\"",
    "build": "turbo run build --filter=@mrd/*",
    "test": "turbo run test --filter=@mrd/*",
    "typecheck": "turbo run typecheck --filter=@mrd/*",
    "start": "pnpm --filter @mrd/api start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Karabo Seipelo",
  "license": "ISC",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
